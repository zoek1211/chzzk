# 치지직 만들기 환경변수 예시. 모두 선택 사항이며, 비워 두면 괄호 안 기본값을 씁니다.
# 실제 비밀 값(TURN 자격 증명, 키스토어 비밀번호)은 이 파일에 적지 말고 실행 환경에서만 설정하세요.

# 서버 포트 (기본 8080)
PORT=8080

# DB 파일과 업로드 영상이 저장되는 디렉터리 (기본 ./data)
CHZZK_DATA_DIR=./data

# 업로드 영상 최대 크기 (기본 2GB)
CHZZK_MAX_UPLOAD_SIZE=2GB

# 시청 정원: 라이브 방송 하나를 동시에 볼 수 있는 시청자 수 (기본 5)
CHZZK_VIEWER_CAPACITY=5

# 라이브 시작 뒤 방송자가 접속해야 하는 제한 시간 (기본 30s). 넘기면 방송이 종료됩니다
# CHZZK_BROADCASTER_JOIN_TIMEOUT=30s

# WebRTC ICE 서버 (선택). STUN 기본값은 공개 Google STUN
# CHZZK_STUN_URL=stun:stun.l.google.com:19302
# TURN은 서로 다른 네트워크 간 연결이 필요할 때만 설정합니다. 값은 저장소에 커밋하지 마세요.
# CHZZK_TURN_URL=turn:turn.example.com:3478
# CHZZK_TURN_USERNAME=
# CHZZK_TURN_CREDENTIAL=

# HTTPS 직접 켜기 (선택, 기본 꺼짐=HTTP). 휴대폰 카메라는 HTTPS 주소에서만 열립니다.
# 키스토어 파일과 비밀번호는 저장소에 커밋하지 마세요.
# CHZZK_SSL_ENABLED=true
# CHZZK_SSL_KEY_STORE=file:./chzzk-keystore.p12
# CHZZK_SSL_KEY_STORE_PASSWORD=
# CHZZK_SSL_KEY_STORE_TYPE=PKCS12
